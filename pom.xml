			<plugin>
			   <groupId>org.apache.maven.plugins</groupId>
			   <artifactId>maven-install-plugin</artifactId>
			   <version>${maven-install-plugin.plugin.version}</version>
			   <executions>
			      <execution>
			         <id>install-docuteam-converter-jar</id>
			         <goals>
			            <goal>install-file</goal>
			         </goals>
			         <phase>validate</phase>
					 <configuration>
					    <groupId>ch.docuteam</groupId>
					    <artifactId>docuteam-converter</artifactId>
					    <version>${project.version}</version>
					    <packaging>jar</packaging>
					    <file>${basedir}/src/main/lib/docuteam-converter-${project.version}.jar</file>
					    <generatePom>false</generatePom>
					    <pomFile>${basedir}/src/main/lib/docuteam-converter-${project.version}.pom</pomFile>
					 </configuration>
			      </execution>
			      <execution>
			         <id>install-docuteam-darc-jar</id>
			         <goals>
			            <goal>install-file</goal>
			         </goals>
			         <phase>validate</phase>
					 <configuration>
					    <groupId>ch.docuteam</groupId>
					    <artifactId>docuteam-darc</artifactId>
					    <version>${project.version}</version>
					    <packaging>jar</packaging>
					    <file>${basedir}/src/main/lib/docuteam-darc-${project.version}.jar</file>
					    <generatePom>false</generatePom>
					    <pomFile>${basedir}/src/main/lib/docuteam-darc-${project.version}.pom</pomFile>
					 </configuration>
			      </execution>
			      <execution>
			         <id>install-docuteam-mapping-jar</id>
			         <goals>
			            <goal>install-file</goal>
			         </goals>
			         <phase>validate</phase>
					 <configuration>
					    <groupId>ch.docuteam</groupId>
					    <artifactId>docuteam-mapping</artifactId>
					    <version>${project.version}</version>
					    <packaging>jar</packaging>
					    <file>${basedir}/src/main/lib/docuteam-mapping-${project.version}.jar</file>
					    <generatePom>false</generatePom>
					    <pomFile>${basedir}/src/main/lib/docuteam-mapping-${project.version}.pom</pomFile>
					 </configuration>
			      </execution>
			      <execution>
			         <id>install-docuteam-tools-jar</id>
			         <goals>
			            <goal>install-file</goal>
			         </goals>
			         <phase>validate</phase>
					 <configuration>
					    <groupId>ch.docuteam</groupId>
					    <artifactId>docuteam-tools</artifactId>
					    <version>${project.version}</version>
					    <packaging>jar</packaging>
					    <file>${basedir}/src/main/lib/docuteam-tools-${project.version}.jar</file>
					    <generatePom>false</generatePom>
					    <pomFile>${basedir}/src/main/lib/docuteam-tools-${project.version}.pom</pomFile>
					 </configuration>
			      </execution>
			   </executions>
			   <inherited>false</inherited>
			</plugin>			
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>${maven-javadoc-plugin.plugin.version}</version>
			</plugin>
			<!-- activate using the flag "maven.source.skip=false" -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>${maven-source-plugin.plugin.version}</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>verify</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>${maven-deploy-plugin.plugin.version}</version>
			</plugin>
			<plugin>
				<!-- http://maven.apache.org/enforcer/maven-enforcer-plugin/ added to help Solving Dependency Conflicts in Maven: https://dzone.com/articles/solving-dependency-conflicts-in-maven -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven-enforcer-plugin.plugin.version}</version>
				<configuration>
					<rules>
						<dependencyConvergence/>
					</rules>
				</configuration>
			</plugin>
			<plugin>
				<!-- mvn checkstyle:checkstyle-aggregate -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${maven-checkstyle-plugin.plugin.version}</version>
				<configuration>
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
					<includeResources>false</includeResources>
					<includeTestResources>false</includeTestResources>
					<consoleOutput>true</consoleOutput>
					<logViolationsToConsole>true</logViolationsToConsole>
					<failsOnError>true</failsOnError>
					<failOnViolation>true</failOnViolation>
					<violationSeverity>warning</violationSeverity>
					<configLocation>build-tools/checkstyle.xml</configLocation>
					<suppressionsLocation>build-tools/checkstyle-suppressions.xml</suppressionsLocation>
					<inputEncoding>UTF-8</inputEncoding>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-site-plugin</artifactId>
				<version>3.7.1</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-project-info-reports-plugin</artifactId>
				<version>3.0.0</version>
			</plugin>
		</plugins>
	</build>
