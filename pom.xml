				<packer.artifactId.linux>octave-dist-jre-linux</packer.artifactId.linux>
				<packer.artifactId.mac>octave-dist-jre-mac</packer.artifactId.mac>
				<packer.artifactId.win>octave-dist-jre-win</packer.artifactId.win>
				<packer.branding.prefix>octave-</packer.branding.prefix>
			</properties>
