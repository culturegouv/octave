<?xml version="1.0" encoding="UTF-8"?>
<sipImportTableConfig
        xmlns="ch:docuteam:mapping:csv"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="ch:docuteam:mapping:csv csv-sip-mapping.xsd">

    <csvFormat>
        <charset>UTF-8</charset>
        <delimiter>;</delimiter>
        <quoteCharacter>&quot;</quoteCharacter>
    </csvFormat>

    <sipImportColumnMapping>
        <sipImportColumn tableHeaderLabel="ID" paramID="ID"/>
        <sipImportColumn tableHeaderLabel="ParentID" paramID="parentID"/>
        <sipImportColumn tableHeaderLabel="File" paramID="path"/>
        <sipImportColumn tableHeaderLabel="DescriptionLevel" paramID="descriptionLevel"/>
        <sipImportColumn tableHeaderLabel="Title" paramID="title"/>
    </sipImportColumnMapping>

    <sipImportMetadataColumnMapping>
        <sipImportMetadataColumn tableHeaderLabel="Identifier" matterhornMetsAccessorID="refCode"/>
        <sipImportMetadataColumn tableHeaderLabel="Creator" matterhornMetsAccessorID="origination"/>
        <sipImportMetadataColumn tableHeaderLabel="Subject" matterhornMetsAccessorID="subjectGeneral"/>
        <sipImportMetadataColumn tableHeaderLabel="Description" matterhornMetsAccessorID="scopeContent"/>
        <sipImportMetadataColumn tableHeaderLabel="Publisher" matterhornMetsAccessorID="publisher"/>
        <sipImportMetadataColumn tableHeaderLabel="Contributor" matterhornMetsAccessorID="involved"/>
        <sipImportMetadataColumn tableHeaderLabel="Date" matterhornMetsAccessorID="date"/>
        <sipImportMetadataColumn tableHeaderLabel="Type" matterhornMetsAccessorID="objectType"/>
        <sipImportMetadataColumn tableHeaderLabel="Format" matterhornMetsAccessorID="format"/>
        <sipImportMetadataColumn tableHeaderLabel="Source" matterhornMetsAccessorID="accessNr"/>
        <sipImportMetadataColumn tableHeaderLabel="Language" matterhornMetsAccessorID="language"/>
        <sipImportMetadataColumn tableHeaderLabel="Relation" matterhornMetsAccessorID="relatedMaterial"/>
        <sipImportMetadataColumn tableHeaderLabel="Coverage" matterhornMetsAccessorID="geogName"/>
        <sipImportMetadataColumn tableHeaderLabel="Rights" matterhornMetsAccessorID="accessPolicy"/>
    </sipImportMetadataColumnMapping>

</sipImportTableConfig>